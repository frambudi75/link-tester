# LinkTester Environment Configuration Example
# Copy this file to .env and fill in your values

# External Threat Intelligence API Keys (Optional - gracefully degrades if left empty)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
PHISHTANK_API_KEY=

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=link_tester
DB_USER=root
DB_PASS=

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
